import { renderToStaticMarkup } from "react-dom/server";
import { describe, expect, test } from "vitest";

import { {{ pascalCase name }} } from "./{{ name }}";

describe({{ pascalCase name }}, () => {
  test("renders its title and copy", () => {
    const html = renderToStaticMarkup(
      <{{ pascalCase name }}
        eyebrow="New"
        richText={[
          {
            _key: "block-1",
            _type: "block",
            children: [{ _type: "span", text: "Supporting copy." }],
          },
        ]}
        title="{{ titleCase name }}"
      />
    );

    expect(html).toMatch(/{{ titleCase name }}/u);
    expect(html).toMatch(/Supporting copy\./u);
  });
});
