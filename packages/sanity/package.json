{
  "name": "@repo/sanity",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./image": "./src/image.ts",
    "./keys": "./src/keys.ts",
    "./live": "./src/live.ts",
    "./queries": "./src/queries.ts",
    "./tags": "./src/tags.ts",
    "./types": "./src/sanity.types.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "typecheck": "tsc --noEmit",
    "typegen": "sanity typegen generate && groq-compiler dedupe-types src/sanity.types.ts --out src/sanity.types.ts --typescript node_modules/typescript-6 && groq-compiler typegen src/sanity.types.ts --out src/compiled-queries.ts --share with-params --nested",
    "typegen:watch": "sanity typegen generate --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/blocks": "workspace:*",
    "@repo/internationalization": "workspace:*",
    "@sanity/client": "catalog:",
    "@sanity/image-url": "catalog:",
    "@t3-oss/env-nextjs": "catalog:",
    "groq-compiler": "file:vendor/groq-compiler-0.1.0.tgz",
    "next-sanity": "catalog:",
    "server-only": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@sanity/codegen": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "groq-js": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sanity": "catalog:",
    "styled-components": "catalog:",
    "typescript": "catalog:",
    "typescript-6": "npm:typescript@6.0.3",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
