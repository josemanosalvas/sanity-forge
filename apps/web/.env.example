# --- Sanity (required) ------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Pin to a date >= 2025-02-19 so the API defaults to the `published` perspective.
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01
# Where the Studio runs; used for click-to-edit overlays and to allow framing.
# In production this must be the deployed Studio origin: a loopback value is
# dropped from the frame-ancestors policy and Presentation cannot embed the site.
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Viewer token (required): Sanity Live, Draft Mode, Presentation and Visual Editing.
# Keep it Viewer-scoped: validated Draft Mode sessions receive it in the browser.
SANITY_API_READ_TOKEN=
# Shared secret for the /api/revalidate webhook (optional; the route fails closed
# and refuses secrets shorter than 32 characters). Generate with: openssl rand -base64 32
SANITY_REVALIDATE_SECRET=

# --- Sites --------------------------------------------------------------------
# Site served when the request host matches no known domain (preview URLs,
# plain localhost). One of the keys in packages/internationalization/src/sites.ts.
DEFAULT_SITE=brand-a

# --- Analytics (optional) ---------------------------------------------------
# Vercel Web Analytics and Speed Insights are on unless set to false.
# NEXT_PUBLIC_VERCEL_ANALYTICS=false
# NEXT_PUBLIC_VERCEL_SPEED_INSIGHTS=false
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Observability (optional) -----------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=
# Enable Session Replay explicitly.
# NEXT_PUBLIC_SENTRY_REPLAY=true
# Share of transactions traced (0 to 1); defaults to 1.
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
