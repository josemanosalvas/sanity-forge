# NEXT_PUBLIC_* values are inlined into the browser bundle at build time: only
# public identifiers belong there. Unprefixed values stay on the server; the
# schemas in each package's keys.ts validate both groups at startup.
#
# Next.js reads these files at startup: restart `pnpm dev` after editing them.
# On a Vercel-linked checkout, `vercel env pull apps/web/.env.local` replaces
# the manual copy (`.env.local` is loaded ahead of `.env`).

# --- Sanity (required) ------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Pin to a date >= 2025-02-19 so the API defaults to the `published` perspective.
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01
# Where the Studio runs; used for click-to-edit overlays and to allow framing.
# In production this must be the deployed Studio origin: a loopback value is
# dropped from the frame-ancestors policy and Presentation cannot embed the site.
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Viewer token (required): Sanity Live, Draft Mode, Presentation and Visual Editing.
# Keep it Viewer-scoped: validated Draft Mode sessions receive it in the browser.
SANITY_API_READ_TOKEN=
# Shared secret for the /api/revalidate webhook (optional; the route fails closed
# and refuses secrets shorter than 32 characters). Generate with: openssl rand -base64 32
SANITY_REVALIDATE_SECRET=

# --- Build time ---------------------------------------------------------------
# A web build runs the Studio's schema extraction first (turbo `^typegen`), so
# these must exist wherever `pnpm turbo run build --filter=web` runs.
# SANITY_STUDIO_PROJECT_ID=
# SANITY_STUDIO_DATASET=production

# --- Sites --------------------------------------------------------------------
# Site served when the request host matches no known domain (preview URLs,
# plain localhost). One of the keys in packages/internationalization/src/sites.ts.
DEFAULT_SITE=brand-a

# --- Analytics (optional) ---------------------------------------------------
# Vercel Web Analytics and Speed Insights are on unless set to false.
# NEXT_PUBLIC_VERCEL_ANALYTICS=false
# NEXT_PUBLIC_VERCEL_SPEED_INSIGHTS=false
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Observability (optional) -----------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=
# Session Replay is off, and its recorder left out of the bundle, unless true.
# NEXT_PUBLIC_SENTRY_REPLAY=true
# Share of transactions traced (0 to 1); defaults to 1.
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# --- Tooling (optional) -----------------------------------------------------
# SKIP_ENV_VALIDATION=true   skip schema validation (CI helpers, TypeGen)
# ANALYZE=true               write bundle-analyzer reports during `next build`
# E2E_HAS_CONTENT=true       make Playwright require published home pages
# PLAYWRIGHT_BASE_URL=       run the e2e suite against another server
