# Required Sanity configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Pin to a date >= 2025-02-19 so the API defaults to the `published` perspective.
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01
# Studio origin for click-to-edit overlays and iframe permissions.
# Use the deployed Studio origin in production. Loopback origins cannot frame the site.
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Required Viewer token for Sanity Live and previews.
# Validated Draft Mode sessions receive this token in the browser.
SANITY_API_READ_TOKEN=
# Optional bearer secret shared with the invalidate-tags Sanity Function.
# /api/revalidate refuses requests if the secret is missing or shorter than 32 characters.
# Generate with: openssl rand -base64 32
SANITY_REVALIDATE_SECRET=
# Log each uncached Sanity read with its sync tags.
# SANITY_LOG_READS=true

# Sites
# Site for unrecognized hosts, including preview URLs and plain localhost.
# Use a key from packages/internationalization/src/sites.ts.
DEFAULT_SITE=brand-a

# Optional analytics
# Vercel Web Analytics and Speed Insights are on unless set to false.
# NEXT_PUBLIC_VERCEL_ANALYTICS=false
# NEXT_PUBLIC_VERCEL_SPEED_INSIGHTS=false
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional observability
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_REPLAY=true
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Optional tooling
# ANALYZE=true               write bundle-analyzer reports during `next build`
# E2E_HAS_CONTENT=true       make Playwright require published home pages
# PLAYWRIGHT_BASE_URL=       run the e2e suite against another server
