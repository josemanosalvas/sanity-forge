# --- Sanity (required) ------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Pin to a date >= 2025-02-19 so the API defaults to the `published` perspective.
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01
# Where the Studio runs; used for click-to-edit overlays and to allow framing.
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Viewer token (required): Sanity Live, Draft Mode, Presentation and Visual Editing.
SANITY_API_READ_TOKEN=
# Shared secret for the /api/revalidate webhook (optional; the route fails closed).
SANITY_REVALIDATE_SECRET=

# --- Sites --------------------------------------------------------------------
# Site served when the request host matches no known domain (preview URLs,
# plain localhost). One of the keys in packages/internationalization/src/sites.ts.
DEFAULT_SITE=brand-a

# --- Analytics (optional) ---------------------------------------------------
# NEXT_PUBLIC_VERCEL_ANALYTICS=false
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Observability (optional) -----------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
