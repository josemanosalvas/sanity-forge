SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_TITLE="Sanity Forge"
# Select "development" for local preview origins or "production" for deployed origins.
# Defaults to development under `sanity dev` and production under `sanity build`.
SANITY_STUDIO_PREVIEW_ENVIRONMENT=
# Set after the first `sanity deploy` so later deploys target the same app.
SANITY_STUDIO_APP_ID=
