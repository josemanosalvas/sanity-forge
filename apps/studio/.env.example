SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_TITLE="Sanity Forge"
# Which site origins Presentation opens: "development" (localhost) or "production".
# Defaults to development under `sanity dev` and production under `sanity build`.
SANITY_STUDIO_PREVIEW_ENVIRONMENT=
# Set after the first `sanity deploy`; keeps later deploys on the same app.
SANITY_STUDIO_APP_ID=
